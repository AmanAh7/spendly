# ---------------------------------------------------------------------------
# Spendly environment variables
# Copy this file to ".env" and fill in real values.
# Never commit ".env".
# ---------------------------------------------------------------------------

# Neon pooled connection used by the Next.js application.
DATABASE_URL=

# Neon direct connection used by Prisma migrations and schema operations.
DIRECT_URL=

# Auth.js secret.
# Generate with: npx auth secret
AUTH_SECRET=BETTER_AUTH_SECRET=cf71bc48beb3a693e02253d5101671ce1ae893f024b4b34baff81d1728d62b59

# Resend transactional email — implemented in Phase 3B.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Public application URL.
NEXT_PUBLIC_APP_URL=http://localhost:3000