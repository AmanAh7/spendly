# ---------------------------------------------------------------------------
# Spendly environment variables
# Copy this file to ".env" and fill in real values.
# Never commit ".env".
# ---------------------------------------------------------------------------

# Neon pooled connection used by the Next.js application.
# Use the hostname containing "-pooler".
DATABASE_URL='postgresql://neondb_owner:'

# Neon direct connection used by Prisma migrations and schema operations.
# Use the non-pooler hostname.
DIRECT_URL='postgresql://neondb_owner:'

# Auth.js v5 secret — used in Phase 3.
AUTH_SECRET= "asfdasfasf"

# Resend transactional email — used in Phase 3.
RESEND_API_KEY="sdgsdgsdg"
RESEND_FROM_EMAIL= onboarding@resend.dev

# Public application URL.
NEXT_PUBLIC_APP_URL=http://localhost:3000


CRON_SECRET=abcd1234